<Application x:Class="Lertaro.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/QuickSearchWindow/QuickSearchWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/DataTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Keep outer window/menu outlines transparent across theme changes. -->
            <SolidColorBrush x:Key="WindowBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="MenuBorderBrush" Color="Transparent"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
