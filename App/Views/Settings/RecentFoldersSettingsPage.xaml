<UserControl x:Class="Lertaro.App.Views.Settings.RecentFoldersSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lertaro.App;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox" BasedOn="{StaticResource SettingsTextBox}">
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_RecentFolders]}"
                       FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_Hint]}"
                       TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource TextSecondary2}"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <CheckBox x:Name="ChkEnable" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,20,0"
                      Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_Enable]}"/>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_Capacity]}" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtCapacity" Width="65" Margin="8,0,16,0"
                     AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_Capacity]}"
                     Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_MenuLimit]}" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtMenuLimit" Width="65" Margin="8,0,0,0"
                     AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_MenuLimit]}"
                     Text="{Binding MenuLimit, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
        </WrapPanel>
        <Expander Grid.Row="2" x:Name="ExclusionsExpander" Foreground="{DynamicResource TextPrimary}" IsExpanded="{Binding IsExclusionsExpanded}" Margin="0,0,0,12"
                  Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_Exclusions]}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_ExclusionsHint]}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary2}" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Style="{StaticResource SettingsButton}"
                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_Browse]}"
                            Command="{Binding BrowseExclusionCommand}"/>
                    <TextBox x:Name="TxtExclusions" Height="90" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_Exclusions]}"
                             Text="{Binding ExcludedDirectories, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                </DockPanel>
            </StackPanel>
        </Expander>
        <TextBox Grid.Row="3" x:Name="TxtFilter" Margin="0,0,0,8" Height="32"
                 AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_Search]}"
                 ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_Search]}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="3" Margin="10,0,0,8" VerticalAlignment="Center" IsHitTestVisible="False"
                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_Search]}"
                   Foreground="{DynamicResource TextSecondary2}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ListBox Grid.Row="4" ItemsSource="{Binding Items}" Background="{DynamicResource ControlBackground}"
                 BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 AutomationProperties.Name="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_RecentFolders]}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Text="{Binding LastOpened}" Foreground="{DynamicResource TextSecondary2}" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource SettingsButton}"
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_Remove]}"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button x:Name="BtnClearAll" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource SettingsButton}"
                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_History_Clear_All]}" Command="{Binding ClearCommand}"/>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[RecentFolders_ImmediateHint]}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary2}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
