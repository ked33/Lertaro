<UserControl x:Class="Lertaro.App.Views.Settings.IndexSettings.WhitelistTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Lertaro.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource SettingsCard}">
        <StackPanel>
            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Whitelist_Hint]}"
                       Style="{StaticResource SettingsHintText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock x:Name="PathsLabel"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Whitelist_Paths]}"
                       Foreground="{DynamicResource TextPrimary2}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtPaths" Style="{StaticResource RuleBulkTextBox}"
                     Height="Auto" MinHeight="180" MaxHeight="360" AcceptsReturn="True" AcceptsTab="False"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.LabeledBy="{Binding ElementName=PathsLabel}"
                     Text="{Binding Whitelist.Paths, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
            <TextBlock Text="{Binding Whitelist.ValidationMessage}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary2}" Margin="0,8,0,0"/>
            <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Folder_AddBtn]}"
                    Command="{Binding Whitelist.BrowseCommand}" Style="{StaticResource SettingsButton}"
                    HorizontalAlignment="Right" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
