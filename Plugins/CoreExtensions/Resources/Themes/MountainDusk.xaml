<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Mountain Dusk / 暮山青: cool charcoal, misty jade and soft mineral accents. -->
    <sys:String x:Key="ThemeId">MountainDusk</sys:String>
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">1.0</sys:Double>

    <!-- Keep transparent search boxes (CardBackground / HeaderBg) and filled search
         controls (ControlBackground) on the exact same #262B31 canvas as ContentBg. -->
    <SolidColorBrush x:Key="CardBackground" Color="#262B31"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#48545E"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E5EBEF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#AFBDC7"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#8FC8BE"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#34474B"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#3B454E"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#D9BC88"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#AFBDC7"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#AFBDC7"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#262B31"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#56646E"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#354149"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#2B3036"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#3B454E"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#7B8A95"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#48545E"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#2D343B"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#48545E"/>
    <SolidColorBrush x:Key="MenuText" Color="#E5EBEF"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#7B8A95"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#AFBDC7"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#354149"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#262B31"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#2D343B"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#48545E"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#3B454E"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#2D343B"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#AFBDC7"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#48545E"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#22272D"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#303B43"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#34474B"/>
    <SolidColorBrush x:Key="SidebarText" Color="#AFBDC7"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#E5EBEF"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#8FC8BE"/>
    <SolidColorBrush x:Key="ContentBg" Color="#262B31"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#262B31"/>
    <SolidColorBrush x:Key="ItemHover" Color="#34474B"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#34474B"/>
    <SolidColorBrush x:Key="AccentBarColor" Color="#8FC8BE"/>
    <SolidColorBrush x:Key="BorderColor" Color="#48545E"/>
    <SolidColorBrush x:Key="AccentColor" Color="#8FC8BE"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#E5EBEF"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#AFBDC7"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#262B31"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#AFBDC7"/>

    <!-- Status colors stay distinct without competing with the jade selection accent. -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#A8C99B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E2C18D"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#3B342A"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#7B6648"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#304247"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#547B76"/>
    <SolidColorBrush x:Key="BadgeText" Color="#B5DCD4"/>
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#1F292D"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#A4D5CC"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#7BB6AC"/>
    <SolidColorBrush x:Key="SecondaryButtonText" Color="#AFBDC7"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#E5EBEF"/>

    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#2E3B31"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#58734F"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#A8C99B"/>
    <SolidColorBrush x:Key="ErrorBackground" Color="#412F36"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#865A64"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#E5A0AA"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#262B31"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#48545E"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#93A3AF"/>

    <Color x:Key="ShadowColor">#101820</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes. -->
    <SolidColorBrush x:Key="#333333" Color="#E5EBEF"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#E5EBEF"/>
    <SolidColorBrush x:Key="#333" Color="#E5EBEF"/>
    <SolidColorBrush x:Key="VideoIconColor" Color="#E5A0AA"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#B7ABD5"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#8FC8BE"/>

    <!-- Visible at the scrollbar's 0.6 resting opacity on every surface above. -->
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#7B8D99"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#9CB2BB"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#8FC8BE"/>
    <!-- CloseButton also uses PrimaryButtonText, so its hover fill stays light. -->
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E5A0AA"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#A8C99B"/>

</ResourceDictionary>
